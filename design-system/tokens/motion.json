{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Motion tokens. Durations in ms so both CSS and Flutter (Duration(milliseconds:)) consume them directly. Every consumer must honour the reduced-motion preference.",
  "motion": {
    "duration": {
      "instant": { "$type": "duration", "$value": 120 },
      "fast": { "$type": "duration", "$value": 180 },
      "normal": { "$type": "duration", "$value": 280 },
      "slow": { "$type": "duration", "$value": 420 },
      "entrance": { "$type": "duration", "$value": 500 },
      "spinner": { "$type": "duration", "$value": 750 }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] },
      "entrance": { "$type": "cubicBezier", "$value": [0.22, 0.9, 0.27, 1.01], "$description": "Slight overshoot — card/section entrance" },
      "exit": { "$type": "cubicBezier", "$value": [0.4, 0, 1, 1] },
      "spring": { "$type": "cubicBezier", "$value": [0.34, 1.56, 0.64, 1], "$description": "Pop — success checkmarks" }
    },
    "stagger": {
      "step": { "$type": "duration", "$value": 45, "$description": "Delay between consecutive staggered children" },
      "max": { "$type": "number", "$value": 8, "$description": "Cap on staggered children before delay stops growing" }
    }
  }
}
