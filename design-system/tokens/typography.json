{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Type ramp. Sizes are in px (unitless numbers) so Flutter can consume them directly; the CSS build appends px.",
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": ["-apple-system", "BlinkMacSystemFont", "Inter", "Segoe UI", "system-ui", "sans-serif"],
        "$flutter": "Inter"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": ["SF Mono", "Fira Code", "Roboto Mono", "monospace"],
        "$flutter": "RobotoMono"
      }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "size": {
      "xs": { "$type": "dimension", "$value": 11.5 },
      "sm": { "$type": "dimension", "$value": 12 },
      "base": { "$type": "dimension", "$value": 13.5 },
      "md": { "$type": "dimension", "$value": 14 },
      "lg": { "$type": "dimension", "$value": 15 },
      "xl": { "$type": "dimension", "$value": 19 },
      "2xl": { "$type": "dimension", "$value": 21 },
      "3xl": { "$type": "dimension", "$value": 26 },
      "otp": { "$type": "dimension", "$value": 22 }
    },
    "tracking": {
      "tight": { "$type": "dimension", "$value": -0.03, "$description": "em — display headings" },
      "snug": { "$type": "dimension", "$value": -0.02, "$description": "em — headings" },
      "normal": { "$type": "dimension", "$value": -0.01, "$description": "em — body, the app default" },
      "wide": { "$type": "dimension", "$value": 0.12, "$description": "em — uppercase dividers/eyebrows" }
    },
    "lineHeight": {
      "tight": { "$type": "number", "$value": 1.2 },
      "normal": { "$type": "number", "$value": 1.45 },
      "relaxed": { "$type": "number", "$value": 1.5 }
    }
  }
}
